{
  "name": "@local/dynamic-workflow",
  "version": "0.2.0",
  "private": true,
  "description": "Run JSON workflows with /workflow, inspect progress, select subagent models, and resume with valid completed results preserved.",
  "repository": {
    "type": "git",
    "url": "https://github.com/orion-nebula-dev/dsh-Dynamic-Workflow.git"
  },
  "homepage": "https://github.com/orion-nebula-dev/dsh-Dynamic-Workflow#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "workflow", "agents"],
  "engines": { "dsh": ">=0.2.1-rc.5 <0.3.0-0" },
  "type": "module",
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.3", "zod": "^4.6.7" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.mjs", "continuation.mjs", "global.mjs", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "workflow.example.json", "README.md", "README.en.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  }
}
